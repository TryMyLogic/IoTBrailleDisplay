<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DisplayApp"
             x:Class="DisplayApp.MainPage"
             Title="IoTBraille Display Home"
             BackgroundColor="#302F3F"
             xmlns:views="clr-namespace:DisplayApp.Views">

    <Grid ColumnDefinitions="Auto,*">
        <!-- Sidebar Navigation -->
        <views:CustomNavBar Grid.Column="0"
                            VerticalOptions="Fill"
                            HorizontalOptions="Start"/>

        <!-- Main Content -->
        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="40,40,40,20" Spacing="30" HorizontalOptions="Center">

                <!-- Page Title -->
                <Label Text="Home Sweet Home"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />

                <!-- Rooms Section -->
                <Label Text="Rooms"
                       TextColor="#A678E2"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <CollectionView ItemsSource="{Binding Areas}"
                                SelectionMode="None"
                                HorizontalOptions="Center"
                                WidthRequest="500">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2"
                                         HorizontalItemSpacing="20"
                                         VerticalItemSpacing="20"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="#3E3C5C"
                                   CornerRadius="15"
                                   Padding="20"
                                   HasShadow="True"
                                   Margin="20">
                                <StackLayout HorizontalOptions="Center">
                                    <Label Text="{Binding name}" 
                                           TextColor="White" 
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" />
                                </StackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=BindingContext.OpenAreaCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
