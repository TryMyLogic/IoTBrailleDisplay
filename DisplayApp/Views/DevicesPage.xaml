<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Name="DevicesPageRoot"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="DisplayApp.Views.DevicesPage"
             Title="Devices"
             BackgroundColor="#302F3F">

    <!-- Main Grid -->
    <Grid Padding="20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Room Name -->
            <RowDefinition Height="Auto"/>
            <!-- Loading Indicator -->
            <RowDefinition Height="*"/>
            <!-- Devices Collection -->
        </Grid.RowDefinitions>

        <!-- Room Name -->
        <Label x:Name="RoomNameLabel"
               Grid.Row="0"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="#A678E2"
               HorizontalOptions="Center" />

        <!-- Loading Indicator -->
        <ActivityIndicator x:Name="LoadingIndicator"
                           Grid.Row="1"
                           IsRunning="False"
                           IsVisible="False"
                           Color="#A678E2"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- Devices Collection -->
        <CollectionView x:Name="DevicesCollection"
                        Grid.Row="2"
                        SelectionMode="Single"
                        SelectionChanged="OnDeviceSelected"
                        IsVisible="{Binding IsRunning, Source={x:Reference LoadingIndicator}, Converter={StaticResource InverseBooleanConverter}}">

            <!-- Layout: 1 column by default, can adjust in code for tablets -->
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="1" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="#3E3C5C"
                           CornerRadius="10"
                           Padding="10"
                           Margin="0,5"
                           HorizontalOptions="Fill">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference DevicesPageRoot}, Path=BindingContext.OpenDeviceCommand}"
                              CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Device Info -->
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding name, FallbackValue='Unknown Device'}"
                                       TextColor="White"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding model, FallbackValue='Unknown Model'}"
                                       TextColor="Gray"
                                       FontSize="12" />
                            </VerticalStackLayout>

                            <!-- Assign Area Button -->
                            <Button Grid.Column="1"
                                    Text="✏️ Edit"
                                    FontSize="14"
                                    Padding="10,0"
                                    WidthRequest="80"
                                    HeightRequest="40"
                                    Clicked="OnDeviceOptionsClicked"
                                    Command="{Binding Source={x:Reference DevicesPageRoot}, Path=BindingContext.ShowAreaPickerCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#5A5A7A"
                                    TextColor="White"
                                    CornerRadius="8" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
