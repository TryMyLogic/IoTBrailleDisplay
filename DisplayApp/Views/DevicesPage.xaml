<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Name="DevicesPageRoot"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="DisplayApp.Views.DevicesPage"
             Title="Devices"
             BackgroundColor="#302F3F"
             xmlns:views="clr-namespace:DisplayApp.Views">
    <Grid ColumnDefinitions="Auto,*">
        <VerticalStackLayout Padding="20" Spacing="10" Grid.Column="1">
            <Label x:Name="RoomNameLabel"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="#A678E2"
               HorizontalOptions="Center" />

            <ActivityIndicator x:Name="LoadingIndicator"
                           IsRunning="False"
                           Color="#A678E2"
                           IsVisible="False"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

            <CollectionView x:Name="DevicesCollection"
                SelectionMode="Single"
                SelectionChanged="OnDeviceSelected"
                IsVisible="{Binding IsRunning, Source={x:Reference LoadingIndicator}, Converter={StaticResource InverseBooleanConverter}}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#3E3C5C" CornerRadius="10" Padding="10" Margin="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Device Info -->
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding name, FallbackValue='Unknown Device'}"
                           TextColor="White"
                           FontSize="16"
                           FontAttributes="Bold" />
                                    <Label Text="{Binding model, FallbackValue='Unknown Model'}"
                           TextColor="Gray"
                           FontSize="12" />
                                </VerticalStackLayout>

                                <!-- Assign Area Button -->
                                <Button Grid.Column="1"
                        Text="✏️ Edit"
                        FontSize="14"
                        Padding="10,0"
                        WidthRequest="80"
                        HeightRequest="40"
                        Clicked="OnDeviceOptionsClicked"
                        Command="{Binding Source={x:Reference DevicesPageRoot}, Path=BindingContext.ShowAreaPickerCommand}"
                        CommandParameter="{Binding .}"
                        BackgroundColor="#5A5A7A"
                        TextColor="White"
                        CornerRadius="8" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
