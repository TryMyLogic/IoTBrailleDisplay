<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DisplayApp.Views.DevicesPage"
             Title="Devices"
             BackgroundColor="#302F3F"
             xmlns:views="clr-namespace:DisplayApp.Views">
    <Grid ColumnDefinitions="Auto,*">
        <!-- Sidebar Navigation -->
        <views:CustomNavBar Grid.Column="0"
                    VerticalOptions="Fill"
                    HorizontalOptions="Start"/>
        <VerticalStackLayout Padding="20" Spacing="10" Grid.Column="1">
            <Label x:Name="RoomNameLabel"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="#A678E2"
               HorizontalOptions="Center" />

            <ActivityIndicator x:Name="LoadingIndicator"
                           IsRunning="False"
                           Color="#A678E2"
                           IsVisible="False"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

            <CollectionView x:Name="DevicesCollection"
                SelectionMode="Single"
                SelectionChanged="OnDeviceSelected"
                IsVisible="{Binding IsRunning, Source={x:Reference LoadingIndicator}, Converter={StaticResource InverseBooleanConverter}}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#3E3C5C"
                           CornerRadius="10"
                           Padding="10"
                           Margin="5">
                            <VerticalStackLayout>
                                <Label Text="{Binding name, FallbackValue='Unknown Device'}" 
                                   TextColor="White" 
                                   FontSize="16"
                                   FontAttributes="Bold" />
                                <Label Text="{Binding model, FallbackValue='Unknown Model'}" 
                                   TextColor="Gray" 
                                   FontSize="12" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
