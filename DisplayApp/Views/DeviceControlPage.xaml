<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DisplayApp.Views.DeviceControlPage"
             BackgroundColor="#2D2B3E"
             Title="Control Panel"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*">

        <!-- Device name centered at top -->
        <Label x:Name="DeviceNameLabel"
               Grid.Row="0"
               TextColor="#A678E2"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               HorizontalTextAlignment="Center"
               Margin="0,30,0,10"
               Text="{Binding DeviceName}" />

        <!-- Main content -->
        <Grid Grid.Row="1" Padding="20">

            <!-- LeftPane is hidden for now -->
            <StackLayout x:Name="LeftPane"
                         HorizontalOptions="Center"
                        VerticalOptions="Start"
                        Spacing="20" />

            <!-- RightPane centered -->
            <StackLayout x:Name="RightPane"
                         IsVisible="False"
                        HorizontalOptions="Fill"
                        VerticalOptions="Start"
                        Spacing="20" />
        </Grid>

        <!-- Loading Indicator overlay -->
        <ActivityIndicator x:Name="LoadingIndicator"
                           Grid.Row="1"
                           IsRunning="False"
                           IsVisible="False"
                           Color="#A678E2"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
