<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DisplayApp.Views.DeviceControlPage"
             Background="#2D2B3E"
             Title="Control Panel"
             NavigationPage.HasNavigationBar="False">

    <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,*">

        <!-- Sidebar -->
        <Frame Grid.RowSpan="2" BackgroundColor="#3B3950" CornerRadius="20" HasShadow="False" Padding="0" Margin="0">
            <StackLayout Spacing="30" Padding="10" VerticalOptions="Center" HorizontalOptions="Center">
                <Image Source="user_icon.png" HeightRequest="28" />
                <Image Source="home_icon.png" HeightRequest="28" />
                <Image Source="settings_icon.png" HeightRequest="28" />
            </StackLayout>
        </Frame>

        <!-- Device name centered at top -->
        <Label x:Name="DeviceNameLabel"
               Grid.Column="1"
               Grid.Row="0"
               TextColor="#A678E2"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               Margin="0,30,0,10" />

        <!-- Back Button -->
        <Button Text="← Back"
                Grid.Column="1"
                Grid.Row="1"
                Margin="20,0"
                BackgroundColor="#A678E2"
                TextColor="White"
                CornerRadius="25"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Clicked="OnBackClicked" />

        <!-- Main Controls -->
        <Grid Grid.Row="1" Grid.Column="1"
              Padding="40" ColumnSpacing="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left dynamic slot -->
            <StackLayout x:Name="LeftPane"
                         Grid.Column="0"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Spacing="20" />

            <!-- Right dynamic slot -->
            <StackLayout x:Name="RightPane"
                         Grid.Column="1"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Spacing="20" />
        </Grid>
    </Grid>



</ContentPage>
